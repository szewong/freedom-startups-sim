# Environments and caches — each sim carries its own.
**/.venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
*.egg-info/
uv.lock

# Bulk simulation outputs — large, and regenerable from a config plus its seed.
# The small JSON summaries alongside them ARE tracked: they are the papers' data,
# so every reported number can be checked without re-running an experiment.
**/results/**/*.parquet
**/results/**/*.npz

# Full-page screenshots (~2 MB each); the papers' own figures are tracked.
**/figures/site-*.png
**/figures/sim-*.png

# Built pages — regenerate with each sim's build script.
**/web/index.html

# Agent worktrees and local session state — never publish these.
.claude/
