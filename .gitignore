# Bulk simulation outputs — large, and regenerable from a config + its seed.
# The small JSON summaries alongside them ARE tracked: they are the paper's
# data, and keeping them means every number in PAPER.md can be checked without
# re-running an experiment.
results/**/seasons.parquet
results/**/final_populations.npz

# Full-page site screenshots (~2 MB each, regenerated by scripts/screenshot_site.py).
# The paper's own figures are tracked.
figures/site-*.png

# Built site — regenerate with:
#   python scripts/build_site.py results/threshold10 web/index.html
web/index.html
